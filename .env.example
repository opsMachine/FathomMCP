# ──────────────────────────────────────────────────────────────────────────────
# FathomMCP — environment
# Copy to .env and fill in ONE of the two auth modes below. Never commit .env.
# ──────────────────────────────────────────────────────────────────────────────

# Where the corpus lives. Defaults to the FathomMCP repo root if unset.
# In the OM-Repo workspace this is set to fathom-vault/:
#   FATHOM_DATA_ROOT=/home/you/Documents/GitHub/OM-Repo/fathom-vault
FATHOM_DATA_ROOT=

# ──────────────────────────────────────────────────────────────────────────────
# AUTH MODE A — Direct (simplest; fine for personal use where only YOU run extract)
# Set FATHOM_API_KEY to your real key. Use npm run extract / npm run import:embed.
# The key lives in this gitignored file. Agents can potentially grep it.
# ──────────────────────────────────────────────────────────────────────────────
# FATHOM_API_KEY=your_real_key_here

# ──────────────────────────────────────────────────────────────────────────────
# AUTH MODE B — OneCLI gateway (recommended; key stays encrypted in vault)
# Real key lives in OneCLI (https://github.com/onecli/onecli):
#   Secret name: Fathom | Host: api.fathom.ai | Header: X-Api-Key | Format: {value}
# Use npm run extract:onecli / npm run import:embed:onecli
# Nightly sync auto-detects OneCLI when ONECLI_AGENT_ACCESS_TOKEN is set.
# CA cert must be extracted once: docker cp onecli:/app/data/gateway/ca.pem ~/.onecli/gateway-ca.pem
# ──────────────────────────────────────────────────────────────────────────────
FATHOM_API_KEY=Fathom
ONECLI_GATEWAY=http://127.0.0.1:10255
ONECLI_AGENT_ACCESS_TOKEN=
# ONECLI_AOC_TOKEN=     # optional: aoc_ token from OneCLI dashboard agents page (different from oc_ management token)
