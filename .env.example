# Fathom API token (required). Issue from https://app.fathom.video/settings/integrations.
FATHOM_API_KEY=

# Where the corpus lives. Defaults to the FathomMCP repo root if unset, so
# a fresh `git clone` of just FathomMCP keeps working with no env setup.
#
# In the OM-Repo workspace this points to the in-repo vault folder
# so the data and the strategy artifacts live in one place:
#
#   FATHOM_DATA_ROOT=/home/you/Documents/GitHub/OM-Repo/fathom-vault
#
# All sub-paths (data/, vault/, config/labels.yml, data/.sync.lock, etc.)
# are resolved relative to this root by src/lib/paths.ts and by
# scripts/nightly-sync.sh.
FATHOM_DATA_ROOT=
